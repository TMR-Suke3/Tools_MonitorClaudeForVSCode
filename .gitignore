# --- Secrets (top priority: never commit these) ------------
# A negation (!) does nothing unless it comes after the line that excluded the
# file, and nothing at all if a parent directory is excluded.
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
*.jks
credentials.json
client_secret*.json
service-account*.json
token*.json
secrets/
*.secret

# SSH keys, package-registry and cloud-CLI credentials.
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*
.npmrc
.pypirc
.netrc
_netrc
.aws/
.azure/
.gcloud/
gha-creds-*.json

# --- Claude Code -------------------------------------------
.claude/settings.local.json
.claude/**/*.local.*
.claude/logs/
.claude/transcripts/
CLAUDE.local.md

# --- Local-only rules and notes ----------------------------
.notes/rules/
_rules/

# --- Working notes and raw agent logs ----------------------
.notes/
scratch/
_scratch/
tmp/
temp/
draft/
personal/
private/
TODO.local.md
plan.local.md

# --- Dependencies and build output -------------------------
# Delete the dist/ build/ out/ lines if a repository deliberately commits its
# build output -- for npm publish, GitHub Pages, or a binary release.
node_modules/
.pnp.*
dist/
build/
out/

# Yarn Berry: do not exclude .yarn/ wholesale -- releases and plugins are committed.
.yarn/*
!.yarn/releases/
!.yarn/plugins/
!.yarn/sdks/
!.yarn/versions/
.next/
.nuxt/
target/
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.egg-info/

# --- Logs and caches ---------------------------------------
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
.cache/
coverage/
.nyc_output/

# --- Editors and OS ----------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# --- Large files (drop these if the repository uses Git LFS) ---
*.mp4
*.mov
*.zip
*.7z
*.psd
*.blend
*.fbx

# --- Tauri generated files ---------------------------------
# tauri-build rewrites crates/board/gen/ on every build. Its contents follow from
# the configuration, so committing it adds no information -- only a line-ending
# difference in every diff.
crates/board/gen/

# The hook helper, staged for the bundler as a sidecar. A build artefact copied out of
# target/, not a source file -- the release workflow puts it here from the build it just
# made, so a stale committed copy could ship instead of the one that was tested.
crates/board/binaries/
